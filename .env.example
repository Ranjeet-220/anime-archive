# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres@localhost:5432/animearchive"

# Auth
AUTH_SECRET=<generate-a-random-secret>
ADMIN_EMAIL="admin@animearchive.local"
ADMIN_PASSWORD=<choose-a-strong-password>

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional global title search (Node.js 24+, finalized SQLite snapshot without a WAL sidecar)
# ANIME_GLOBAL_DB_PATH="/absolute/path/to/anime_archive.db"
